# ===== .env.real — REAL-money overrides (loaded AFTER .env; only put what differs) =====
# The real service reuses keys + Google creds from /opt/trend-live/.env, then overrides these:

LIVE_DRY_RUN=false          # REAL orders (the whole point)
LIVE_ENABLED=true

# --- keep the REAL side SAFE: liquid core only, tiny size, NO dynamic microcaps ---
LIVE_ASSETS=SOL,XRP
LIVE_DYNAMIC_SLOTS=0        # do NOT scan illiquid movers with real money (that's Phase 2 w/ maker)
LIVE_MODE=intraday          # active, matching what we're testing
LIVE_BET_USD=5
LIVE_LEV_MAX=5              # ~5x on real bets
LIVE_MAX_NOTIONAL_POS=35
LIVE_MAX_NOTIONAL_TOTAL=60
LIVE_MAX_CONCURRENT=2
LIVE_DAILY_LOSS_STOP=0.15   # tighter kill-switch on real money (halt at -15%/day)
LIVE_MIN_BALANCE=3          # if free USDT < this -> stop new trades + Telegram alert (auto-resume on top-up)
LIVE_MAX_SPREAD=0.003       # stricter spread filter for real fills
LIVE_POLL_SECS=120

# --- Telegram: label REAL vs SIM, ping every trade, hourly report ---
LIVE_TAG=REAL
LIVE_TG_TRADES=true
LIVE_REPORT_HOURS=1

# --- separate logging so real and sim don't mix ---
LIVE_SHEET_TAB=Live Real
