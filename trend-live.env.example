# ===== TrendLive .env  (copy to /opt/trend-live/.env on the VPS and fill in) =====
# Binance USDT-M Futures key — created AFTER the Futures wallet existed,
# IP-restricted to THIS server's IP, Enable Futures ON, Withdrawals OFF.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- safety gates (leave DRY_RUN=true until you've read the [DRY] logs!) ----
LIVE_ENABLED=true
LIVE_DRY_RUN=true

# ---- sizing (defaults tuned for a $1 stake on low-min-notional alts) ----
LIVE_ASSETS=SOL,XRP
LIVE_BET_USD=1
LIVE_LEV_MIN=1
LIVE_LEV_MAX=5

# ---- dynamic high-volatility slots (SIM/forecast only): pick N daily movers that pass the trend gate ----
LIVE_DYNAMIC_SLOTS=2
LIVE_DYNAMIC_MIN_VOL=50000000
LIVE_DYNAMIC_REFRESH_MIN=60
# LIVE_DYNAMIC_EXCLUDE=BTC,ETH,USDC,FDUSD,DAI

# ---- signal mode + friction realism ----
LIVE_MODE=intraday                 # intraday (active) or daily (validated)
LIVE_POLL_SECS=120
LIVE_MAX_SPREAD=0.004              # skip coins with spread > 0.4% (illiquid junk)
LIVE_SIM_SLIPPAGE=true            # charge half-spread + impact on each SIM fill (honest forecast)
LIVE_SIM_SLIP_EXTRA=0.0002
LIVE_MAX_NOTIONAL_POS=40
LIVE_MAX_NOTIONAL_TOTAL=80
LIVE_MAX_CONCURRENT=2
LIVE_DAILY_LOSS_STOP=0.25
LIVE_POLL_SECS=900

# ---- optional: Google Sheets logging (paste the service-account JSON on ONE line) ----
# GOOGLE_SHEETS_CREDENTIALS_JSON=
# TP_SPREADSHEET_ID=

# ---- Telegram: label as SIM, ping every sim trade, report every 2h ----
LIVE_TAG=SIM
LIVE_TG_TRADES=true
LIVE_REPORT_HOURS=2
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
